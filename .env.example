# Copy to .env and adjust. Every variable is optional: the values below are the defaults the
# code already uses. .env is git-ignored; never commit real keys.
# docker compose reads ANTHROPIC_API_KEY and API_KEY from this file or from your shell.

# PostgreSQL with pgvector. The compose container listens on 127.0.0.1:5444.
DATABASE_URL=postgresql://rag:rag@localhost:5444/rag

# Local ONNX models (downloaded on first use): no API key and no GPU needed.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Must match vector(384) in app/schema.sql. Change both together, and the embedding model too.
EMBED_DIM=384
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Chunking: sentence-aware windows that never cross a page boundary.
CHUNK_WORDS=120
OVERLAP_WORDS=30

# Retrieval. CANDIDATES is per channel (dense, full-text), before fusion.
CANDIDATES=30
RRF_K=60
# Fused candidates the cross-encoder rereads (about 45 ms each on CPU).
RERANK_POOL=10
# Cross-encoder score below which the service refuses to answer (calibration: eval/RESULTS.md).
MIN_RERANK_SCORE=-3.0

# Answers. Empty = extractive answers and nothing leaves your machine.
# Set a key to get LLM-written answers with citations.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-haiku-5-5

# Empty = no authentication (the demo binds to 127.0.0.1 only). Set a long random secret to
# require an X-API-Key header on every endpoint except /health.
API_KEY=
MAX_UPLOAD_MB=20

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
